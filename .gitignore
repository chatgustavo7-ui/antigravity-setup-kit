# Antigravity Setup Kit - Regras de Gitignore rígidas para segredos e bancos de dados

# Arquivos de ambiente e segredos
.env
*.env
.env.*
!.env.example
*.local
secrets.json
secret.json
*secret*.json

# Credenciais e chaves do GCP / OAuth / APIs
*oauth*.json
*credentials*.json
*credential*.json
client_secret*.json
*.pem
*.pkcs12
*.pfx
*.p12
*.key
*.pub

# Bancos de dados e SQLite
*.sqlite
*.sqlite3
*.db3
*.s3db
*.sl3
# Banco de dados genéricos
*.db

# Diretórios que possam conter dados sensíveis ou segredos
**/secrets/
**/credentials/

# IDE e logs do sistema
.vscode/
.idea/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Exclusão rígida de segredos e tokens locais
# (wildcards *token*/*tokens* removidos - bloqueavam ate codigo-fonte legitimo
# so por conter "tokens" no nome, ex: testes de autenticacao. security_check.ps1
# ja faz deteccao de segredos reais por conteudo/regex, nao por nome de arquivo)
*.token
token.json
*_token.txt
*_token.json
mcp_oauth_tokens.json

# Pacotes do ecossistema de desenvolvimento (Node.js e Python)
node_modules/
**/node_modules/
.venv/
venv/
**/.venv/
**/venv/

# Artefato de build do instalador (gerado via ISCC, anexado manualmente aos Releases)
installer/Output/

# Saida gerada ao rodar a suite de testes E2E (tests_e2e/run_tests.ps1)
tests_e2e/mocks/
tests_e2e/sandbox/
tests_e2e/reports/
